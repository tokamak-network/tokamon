{
  "hosting": {
    "public": "client/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/faucet/**", "run": { "serviceId": "listener-server", "region": "asia-northeast3" } },
      { "source": "/api/spots/**", "run": { "serviceId": "listener-server", "region": "asia-northeast3" } },
      { "source": "/api/spots", "run": { "serviceId": "listener-server", "region": "asia-northeast3" } },
      { "source": "/api/**", "function": "api" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "cp shared/networks.js functions/shared/networks.js"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
