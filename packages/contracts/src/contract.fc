;; Walk to Earn - TON Smart Contract
;; 토큰 스팟 관리 스마트 컨트랙트

#include "stdlib.fc";

;; Storage structure
;; storage#_ owner_address:MsgAddress total_spots:uint32 = Storage;

(slice, int) load_data() inline {
    slice ds = get_data().begin_parse();
    return (
        ds~load_msg_addr(),  ;; owner_address
        ds~load_uint(32)     ;; total_spots
    );
}

() save_data(slice owner_address, int total_spots) impure inline {
    set_data(
        begin_cell()
            .store_slice(owner_address)
            .store_uint(total_spots, 32)
        .end_cell()
    );
}

;; 스팟 생성
() create_spot(
    slice sender_address,
    int token_amount,
    int deposit_amount,
    int latitude,
    int longitude,
    cell spot_data
) impure {
    (slice owner, int total_spots) = load_data();
    
    ;; 최소 예치금 검증
    throw_unless(101, deposit_amount >= token_amount);
    
    ;; 스팟 정보 저장 (실제로는 별도 dictionary 사용)
    ;; TODO: spot_id를 키로 하는 dictionary 구조 필요
    
    ;; 스팟 카운트 증가
    save_data(owner, total_spots + 1);
}

