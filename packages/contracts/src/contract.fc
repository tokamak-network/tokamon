;; 스팟 정보 조회
cell get_spot_info(int spot_id) method_id {
    ;; TODO: dictionary에서 스팟 정보 조회
    return begin_cell().end_cell();
}

;; 총 스팟 수 조회
int get_total_spots() method_id {
    (slice owner, int total_spots) = load_data();
    return total_spots;
}

;; 메인 수신 함수
() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    
    if (flags & 1) {
        return ();
    }
    
    slice sender_address = cs~load_msg_addr();
    
    int op = in_msg_body~load_uint(32);
    
    if (op == 1) {  ;; create_spot
        int token_amount = in_msg_body~load_coins();
        int deposit_amount = in_msg_body~load_coins();
        int latitude = in_msg_body~load_int(32);
        int longitude = in_msg_body~load_int(32);
        cell spot_data = in_msg_body~load_ref();
        
        create_spot(sender_address, token_amount, deposit_amount, latitude, longitude, spot_data);
        return ();
    }
    
    if (op == 2) {  ;; collect_token
        int spot_id = in_msg_body~load_uint(32);
        collect_token(sender_address, spot_id);
        return ();
    }
    
    throw(0xffff);
}
