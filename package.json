{
  "name": "tokamon",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "client",
    "listener-server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "emulators": "JAVA_HOME=/usr/local/opt/openjdk@21 PATH=/usr/local/opt/openjdk@21/bin:$PATH firebase emulators:start --project tokamon-go",
    "listener": "NETWORK=local FIRESTORE_EMULATOR_HOST=localhost:8080 npm run start -w listener-server",
    "listener:prod": "npm run start -w listener-server",
    "listener:thanos-sepolia": "NETWORK=thanos-sepolia npm run start -w listener-server",
    "copy-contracts": "node scripts/copy-contracts.js",
    "deploy": "npm run build && mkdir -p functions/shared && cp shared/networks.js functions/shared/networks.js && firebase deploy",
    "serve": "npm run build && firebase serve",
    "android": "cd app && npx expo run:android",
    "ios": "cd app && npx expo run:ios",
    "postinstall": "cd app && npm install --legacy-peer-deps"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "expo-secure-store": "^15.0.8",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
