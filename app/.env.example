# === API (Firebase Functions) ===
# 미설정 시 로컬 에뮬레이터 주소 사용 (Android: 10.0.2.2, iOS: localhost)
# EXPO_PUBLIC_API_BASE=https://your-project.web.app/api

# === 리스너 서버 (네트워크별) ===
# 미설정 시 로컬 기본값 사용 (local: 3001, thanos-sepolia: 3002)
# EXPO_PUBLIC_LISTENER_URL_LOCAL=http://localhost:3001
# EXPO_PUBLIC_LISTENER_URL_THANOS_SEPOLIA=https://listener-thanos.your-domain.com

# === WalletConnect ===
# https://cloud.walletconnect.com 에서 발급
# EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# === Google Maps ===
# Google Cloud Console에서 발급 (Maps SDK for Android / iOS 활성화 필요)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# === Firebase ===
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# === Device Attestation ===
# Google Cloud 프로젝트 번호 (Android Play Integrity용)
# EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=

# === Initial Position (GPS fallback) ===
# EXPO_PUBLIC_INITIAL_POS_LAT=37.495
# EXPO_PUBLIC_INITIAL_POS_LON=127.063
