rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 멀티체인 구조: networks/{networkId}/collection ───

    // networks/{networkId}/spot_metadata: 누구나 읽기 가능, 쓰기는 Admin SDK만 (listener-server)
    match /networks/{networkId}/spot_metadata/{spotId} {
      allow read: if true;
      allow write: if false;
    }

    // networks/{networkId}/claim_events: 누구나 읽기 가능, 쓰기는 Admin SDK만 (listener-server)
    match /networks/{networkId}/claim_events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // networks/{networkId}/config: 누구나 읽기 가능, 쓰기는 Admin SDK만
    match /networks/{networkId}/config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // networks/{networkId}/telegram_hash_map: Admin SDK만
    match /networks/{networkId}/telegram_hash_map/{hashId} {
      allow read: if true;
      allow write: if false;
    }

    // networks/{networkId}/telegram_wallet_links: Admin SDK만
    match /networks/{networkId}/telegram_wallet_links/{walletId} {
      allow read: if true;
      allow write: if false;
    }

    // networks/{networkId}/device_claim_events: Admin SDK만
    match /networks/{networkId}/device_claim_events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── 하위호환: 기존 flat 컬렉션 (마이그레이션 완료 후 제거 가능) ───

    match /spot_metadata/{spotId} {
      allow read: if true;
      allow write: if false;
    }

    match /claim_events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 그 외 모든 문서: 접근 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
