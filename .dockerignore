# 화이트리스트 방식: 모든 파일 제외 후 필요한 것만 포함
*

# listener-server 소스 포함
!listener-server/
listener-server/node_modules/
listener-server/.env
listener-server/.env.*
listener-server/*.db
listener-server/*.sqlite
listener-server/serviceAccountKey.json
listener-server/contract-address.json
listener-server/spot-metadata*.json
listener-server/last-block*.json
listener-server/__tests__/
listener-server/firebase-debug.log

# shared 모듈 포함
!shared/

# 컨트랙트 ABI 아티팩트 포함 (있으면 사용)
!contracts/out/Tokamon.sol/Tokamon.json

# 공통 제외
.git/
.DS_Store
*.md
