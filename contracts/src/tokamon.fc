;; Tokamon Smart Contract
;; 클라이언트가 직접 클레임하는 방식
;;
;; 플로우:
;;   1. 광고주가 create_spot으로 TON 예치
;;   2. 사용자가 서버에서 서명 증명을 받음 (위치+시간 검증 후)
;;   3. 사용자가 직접 claim 호출 (서명 포함)
;;   4. 컨트랙트가 서명 검증 후 사용자에게 보상 전송
;;
;; Storage:
;;   admin_pubkey:uint256      (서명 검증용 공개키)
;;   next_spot_id:uint32
;;   spots:Dict<uint32, Cell>
;;   claims:Dict<uint256, bool> (사용된 claim_id)
;;
;; Spot Cell:
;;   creator:MsgAddress, reward:Coins, remaining:Coins
;;
;; Ops:
;;   1 = create_spot  (누구나, TON 예치)
;;   2 = claim        (누구나, 서버 서명 필요)
;;   3 = refund       (생성자만, 남은 잔액 환불)

#include "stdlib.fc";

;; ===== Error codes =====
const int ERR_INVALID_SIGNATURE = 100;
const int ERR_CLAIM_ALREADY_USED = 101;
const int ERR_SPOT_NOT_FOUND = 102;
const int ERR_INSUFFICIENT_DEPOSIT = 103;
const int ERR_INSUFFICIENT_REMAINING = 104;
const int ERR_NOT_CREATOR = 105;
const int ERR_CLAIM_EXPIRED = 106;
const int ERR_INVALID_OP = 107;

;; ===== Storage =====

(int, int, cell, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    int admin_pubkey = ds~load_uint(256);
    int next_spot_id = ds~load_uint(32);
    cell spots = ds~load_dict();
    cell claims = ds~load_dict();
    return (admin_pubkey, next_spot_id, spots, claims);
}

() save_data(int admin_pubkey, int next_spot_id, cell spots, cell claims) impure inline {
    set_data(
        begin_cell()
            .store_uint(admin_pubkey, 256)
            .store_uint(next_spot_id, 32)
            .store_dict(spots)
            .store_dict(claims)
        .end_cell()
    );
}

;; ===== Spot helpers =====

cell pack_spot(slice creator, int reward, int remaining) inline {
    return begin_cell()
        .store_slice(creator)
        .store_coins(reward)
        .store_coins(remaining)
    .end_cell();
}

(slice, int, int) unpack_spot(cell spot_cell) inline {
    slice cs = spot_cell.begin_parse();
    return (cs~load_msg_addr(), cs~load_coins(), cs~load_coins());
}

;; ===== Internal message handler =====

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }
    slice sender = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    (int admin_pubkey, int next_id, cell spots, cell claims) = load_data();

    ;; ===== op 1: create_spot =====
    ;; 누구나 TON을 보내서 스팟 생성
    ;; body: reward:Coins
    if (op == 1) {
        int reward = in_msg_body~load_coins();
        int deposit = msg_value - 50000000; ;; 0.05 TON gas reserve
        throw_unless(ERR_INSUFFICIENT_DEPOSIT, deposit >= reward);

        spots~udict_set_ref(32, next_id, pack_spot(sender, reward, deposit));
        save_data(admin_pubkey, next_id + 1, spots, claims);

        ;; 응답: spot_id 알려주기
        var msg = begin_cell()
            .store_uint(0x10, 6)
            .store_slice(sender)
            .store_coins(0)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(0xf1, 32)
            .store_uint(query_id, 64)
            .store_uint(next_id, 32)
        .end_cell();
        send_raw_message(msg, 64);
        return ();
    }

    ;; ===== op 2: claim (사용자가 직접 호출) =====
    ;; body: signature:512bits, spot_id:uint32, claim_id:uint256, valid_until:uint32
    ;; 서버가 서명한 데이터: hash(spot_id, sender, claim_id, valid_until)
    if (op == 2) {
        slice sig_slice = in_msg_body~load_bits(512);
        int spot_id = in_msg_body~load_uint(32);
        int claim_id = in_msg_body~load_uint(256);
        int valid_until = in_msg_body~load_uint(32);

        ;; 만료 확인
        throw_unless(ERR_CLAIM_EXPIRED, now() <= valid_until);

        ;; 중복 클레임 방지
        (_, int already_used) = claims.udict_get?(256, claim_id);
        throw_if(ERR_CLAIM_ALREADY_USED, already_used);

        ;; 서명 검증: hash(spot_id, sender, claim_id, valid_until)
        cell data_cell = begin_cell()
            .store_uint(spot_id, 32)
            .store_slice(sender)
            .store_uint(claim_id, 256)
            .store_uint(valid_until, 32)
        .end_cell();
        int data_hash = cell_hash(data_cell);
        throw_unless(ERR_INVALID_SIGNATURE, check_signature(data_hash, sig_slice, admin_pubkey));

        ;; 스팟 확인
        (cell spot_cell, int found) = spots.udict_get_ref?(32, spot_id);
        throw_unless(ERR_SPOT_NOT_FOUND, found);

        (slice creator, int reward, int remaining) = unpack_spot(spot_cell);
        throw_unless(ERR_INSUFFICIENT_REMAINING, remaining >= reward);

        ;; 잔액 차감 + 클레임 기록
        remaining -= reward;
        spots~udict_set_ref(32, spot_id, pack_spot(creator, reward, remaining));
        claims~udict_set_builder(256, claim_id, begin_cell().store_uint(1, 1));
        save_data(admin_pubkey, next_id, spots, claims);

        ;; 사용자에게 보상 전송
        var msg = begin_cell()
            .store_uint(0x10, 6)
            .store_slice(sender)
            .store_coins(reward)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(0xf2, 32)
            .store_uint(query_id, 64)
            .store_uint(spot_id, 32)
        .end_cell();
        send_raw_message(msg, 1);
        return ();
    }

    ;; ===== op 3: refund (생성자만) =====
    ;; body: spot_id:uint32
    if (op == 3) {
        int spot_id = in_msg_body~load_uint(32);

        (cell spot_cell, int found) = spots.udict_get_ref?(32, spot_id);
        throw_unless(ERR_SPOT_NOT_FOUND, found);

        (slice creator, int reward, int remaining) = unpack_spot(spot_cell);
        throw_unless(ERR_NOT_CREATOR, equal_slices(sender, creator));

        spots~udict_delete?(32, spot_id);
        save_data(admin_pubkey, next_id, spots, claims);

        if (remaining > 0) {
            var msg = begin_cell()
                .store_uint(0x10, 6)
                .store_slice(creator)
                .store_coins(remaining)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_uint(0xf3, 32)
                .store_uint(query_id, 64)
                .store_uint(spot_id, 32)
            .end_cell();
            send_raw_message(msg, 1);
        }
        return ();
    }

    throw(ERR_INVALID_OP);
}

;; ===== Get methods =====

int get_total_spots() method_id {
    (_, int next_id, _, _) = load_data();
    return next_id;
}

(int, int, slice) get_spot_info(int spot_id) method_id {
    (_, _, cell spots, _) = load_data();
    (cell spot_cell, int found) = spots.udict_get_ref?(32, spot_id);
    throw_unless(ERR_SPOT_NOT_FOUND, found);
    (slice creator, int reward, int remaining) = unpack_spot(spot_cell);
    return (reward, remaining, creator);
}

int is_claim_used(int claim_id) method_id {
    (_, _, _, cell claims) = load_data();
    (_, int found) = claims.udict_get?(256, claim_id);
    return found;
}
