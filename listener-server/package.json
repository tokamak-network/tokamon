{
  "name": "listener-server",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "jest"
  },
  "dependencies": {
    "@googleapis/playintegrity": "^3.0.0",
    "appattest-checker-node": "^1.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.0.0",
    "node-telegram-bot-api": "^0.66.0",
    "sqlite3": "^5.1.7"
  },
  "overrides": {
    "node-telegram-bot-api": {
      "@cypress/request-promise": {
        "request-promise-core": {
          "request": {
            "form-data": "^4.0.0",
            "qs": "^6.14.1",
            "tough-cookie": "^5.1.2"
          }
        }
      }
    },
    "tar": "^7.5.8"
  },
  "jest": {
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/*.test.js"
