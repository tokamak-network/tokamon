RPC_URL=http://127.0.0.1:8999
CONTRACT_ADDRESS=0x...
# Firestore 사용 시: Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 → JSON 저장
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# 텔레그램 봇 (BotFather에서 봇 생성 후 토큰 입력, 없으면 봇만 비활성화)
TELEGRAM_BOT_TOKEN=
# Faucet 지급용 지갑 비밀키 (없으면 Anvil 기본키 사용)
# FAUCET_PRIVATE_KEY=0x...
# 선택: 웹 URL(봇 링크 안내용), DB 경로
# WEB_URL=https://your-app.web.app
# DATABASE_PATH=./telegram.db
# Device Attestation (false / log / true)
REQUIRE_ATTESTATION=false
# Google Cloud 프로젝트 번호 (Play Integrity API용)
# GOOGLE_CLOUD_PROJECT_NUMBER=
# iOS App Attest App ID (<TEAM_ID>.<bundle_id>)
# IOS_APP_ATTEST_APP_ID=
